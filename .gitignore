# Local secrets and data — never commit these.
.secret_key
# Stray license from license.js configDir()'s fallback: with no
# AVENTURINE_CONFIG_DIR set (a test or script run by hand from electron/), it
# writes license.json under the CWD instead of the app profile. main.js always
# sets the variable, so this only ever appears in a dev tree.
.config/
electron/.config/
finance.db
finance.db.bak*
*.bak
active-db.json

# Dependencies and build outputs
node_modules/
electron/dist/
electron/out/
static/dist/

# Claude Code local config — machine-local settings + product strategy; keep private.
.claude/
CLAUDE.md

# Environment
.env
MIGRATION.md

# Internal security docs — keep private.
THREAT-MODEL.md

# Design-system component library — kept out of the app repo.
design-system/

# Editor / OS scratch
.DS_Store
.vscode/
.idea/

# Stray H2 (Java) database artifact — not used by this project
storage.mv.db
